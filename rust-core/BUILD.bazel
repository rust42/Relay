load("@rules_cc//cc:defs.bzl", "cc_library")
load("@build_bazel_rules_swift//swift:swift_interop_hint.bzl", "swift_interop_hint")

# Builds rust-core via cargo (arm64 + x86_64 -> lipo universal static lib) and
# regenerates the UniFFI Swift bindings. Not hermetic (needs network to fetch
# crates and the host's rustup toolchain), hence the "local"/"requires-network"
# tags -- see //bazel:build_rust_core.sh and .bazelrc.
genrule(
    name = "rust_core_build",
    srcs = glob([
        "src/**/*.rs",
        "examples/**/*.rs",
        "Cargo.toml",
        "Cargo.lock",
    ]),
    outs = [
        "target/universal/librelay_core.a",
        "generated/swift/relay_core.swift",
        "generated/swift/relay_coreFFI.h",
    ],
    cmd = """
        $(execpath //bazel:build_rust_core.sh) \
            $(RULEDIR)/target/universal/librelay_core.a \
            $(RULEDIR)/generated/swift/relay_core.swift \
            $(RULEDIR)/generated/swift/relay_coreFFI.h
    """,
    tools = ["//bazel:build_rust_core.sh"],
    tags = [
        "local",
        "no-remote-exec",
        "no-sandbox",
        "requires-network",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "relay_coreFFI",
    hdrs = ["generated/swift/relay_coreFFI.h"],
    aspect_hints = [":relay_coreFFI_interop_hint"],
    visibility = ["//visibility:public"],
)

swift_interop_hint(
    name = "relay_coreFFI_interop_hint",
    module_name = "relay_coreFFI",
)

cc_library(
    name = "relay_core_static",
    srcs = ["target/universal/librelay_core.a"],
    linkstatic = True,
    alwayslink = True,
    visibility = ["//visibility:public"],
)
