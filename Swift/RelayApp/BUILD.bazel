load("@build_bazel_rules_apple//apple:macos.bzl", "macos_application")
load("@build_bazel_rules_swift//swift:swift_library.bzl", "swift_library")

swift_library(
    name = "RelayLib",
    srcs = glob(["*.swift"]) + ["//rust-core:generated/swift/relay_core.swift"],
    module_name = "Relay",
    deps = [
        "//rust-core:relay_core_static",
        "//rust-core:relay_coreFFI",
    ],
    linkopts = [
        "-framework",
        "SystemConfiguration",
        "-framework",
        "Security",
        "-lc++",
    ],
)

macos_application(
    name = "Relay",
    bundle_id = "com.sandeep.relay.app",
    entitlements = "Relay.entitlements",
    infoplists = ["//bazel:Info.plist"],
    minimum_os_version = "14.0",
    deps = [":RelayLib"],
    visibility = ["//visibility:public"],
)
